# =============================================================================
# APIx Scraper — Environment Variables
# Copy this to .env and fill in your values
# =============================================================================

# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/apix

# Proxy URLs (comma-separated, optional)
# Format: http://user:pass@proxy-host:port
# Leave empty if not using proxies
PROXY_URLS=

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Daily scrape schedule (24h format)
SCRAPE_HOUR=6
SCRAPE_MINUTE=0

# Scraping delays (seconds)
MIN_DELAY=3
MAX_DELAY=8

# Retry configuration
MAX_RETRIES=3

# Fare validation thresholds (INR)
FARE_MIN_THRESHOLD=500
FARE_MAX_THRESHOLD=50000

# Browser settings
HEADLESS=true
BROWSER_TIMEOUT=30000
